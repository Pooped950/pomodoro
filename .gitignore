# Gradle 在 android/ 下的构建产物（含 problems-report.html）
# 根目录的 /build/ 只覆盖 Flutter 那一份，android/build/ 要单独写
/android/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 模拟器走查的运行时产物（*.log 已在上面统一忽略）
/tools/emu/queue.txt
/tools/emu/logcat.txt

# 构建产物（APK 太大，不进版本库；用 flutter build apk --release 重新生成）
/dist/
